# LOCAL DEVELOPMENT ONLY. Replace every local-only secret/value before any non-local use.
NODE_ENV=development
# Public application origin, supplied at container runtime (not image build time).
APP_URL=http://localhost:3000
AUTH_SECRET=LOCAL-ONLY-DO-NOT-USE-OUTSIDE-DEV-auth-secret-7d2f91c4
AUTH_SESSION_COOKIE_NAME=ab_ignite_session
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=604800
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=28800
AUTH_REFRESH_COOKIE_NAME=ab_ignite_refresh
DEMO_ACCESS_ENABLED=false
DEMO_SESSION_TTL_SECONDS=3600
# Used by host-based `npm run dev`; frontend Compose overrides this with http://api:4100.
API_INTERNAL_URL=http://localhost:4100
INTERNAL_API_TOKEN=LOCAL-ONLY-DO-NOT-USE-OUTSIDE-DEV-internal-token-4a8c63e1
NEXT_PUBLIC_AUTH_REFRESH_INTERVAL_SECONDS=600
