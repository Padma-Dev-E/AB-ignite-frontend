NODE_ENV=production
AUTH_URL=https://your-frontend-hostname
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SESSION_COOKIE_NAME=ab_ignite_session
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_IDLE_SECONDS=1800
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_REFRESH_COOKIE_NAME=ab_ignite_refresh
DEMO_ACCESS_ENABLED=false
DEMO_SESSION_TTL_SECONDS=2592000
API_INTERNAL_URL=http://backend:4100
INTERNAL_API_TOKEN=replace-with-a-separate-long-random-secret
NEXT_PUBLIC_AUTH_REFRESH_INTERVAL_SECONDS=600
